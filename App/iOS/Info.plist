<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<integer>1</integer>
	<key>CFBundleDevelopmentRegion</key>
	<string>tr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.divelog.iphone</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>DiveLog</string>
	<key>CFBundleDisplayName</key>
	<string>DiveLog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>location-services</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ADIM 13: Harita + arka plan senkronizasyonu -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.divelog.iphone.sync</string>
	</array>

	<!-- ADIM 13: Kullanım açıklamaları -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dalış rotanızı haritada gösterebilmek için konumunuzu kullanır. Konum yalnızca dalış sırasında ve yüzeyde kaydedilir.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Dalış sonrası uçuş yasağı sayacını ve dalış günlüğünü güncel tutmak için arka planda konumunuzu kullanır.</string>
	<key>NSMotionUsageDescription</key>
	<string>Derinlik ve hareket verisinden dalış profilini oluşturur.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Dalış verilerinizi Apple Health ile paylaşmak isterseniz okuma izni istenir.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Dalış kayıtlarınızı Apple Health'e yazmak için yazma izni istenir.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Su altı sensör verisini watch'ınıza aktarmak için Bluetooth kullanır.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Dalış profilinizi ve harita görüntünüzü paylaşmak için fotoğraflara kaydetmenize izin verir.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
